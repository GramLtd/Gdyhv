BOT_TOKEN=123456:ABC...
# Кто может пользоваться ботом (ID через запятую). Пусто — все, у каждого свои шаблоны.
ADMIN_IDS=
DB_PATH=postbot.db
# Токен второго бота — магазина шаблонов для пользователей (необязательно).
# Если задан: основной бот только для админов, пользователи покупают и заполняют шаблоны во втором.
SHOP_BOT_TOKEN=
