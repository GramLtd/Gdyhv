[Unit]
Description=XMR Miner Telegram bot + Mini App
After=network-online.target
Wants=network-online.target

[Service]
User=xmrmine
WorkingDirectory=/opt/xmrmine
EnvironmentFile=/opt/xmrmine/.env
Environment=DB_PATH=/opt/xmrmine/game.db
ExecStart=/opt/xmrmine/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
